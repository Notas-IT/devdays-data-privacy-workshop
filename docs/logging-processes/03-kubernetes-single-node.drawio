        <mxCell id="node" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;NODE 1 · single-node cluster; control-plane components omitted&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=18;container=1;collapsible=0;" vertex="1" parent="cluster">
          <mxGeometry x="40" y="75" width="2290" height="1845" as="geometry" />
        </mxCell>
        <mxCell id="hr" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;HR application Pod&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Continuously writes stdout / stderr.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="node">
          <mxGeometry x="155" y="165" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="billing" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;Billing application Pod&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Continuously writes stdout / stderr.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="node">
          <mxGeometry x="655" y="165" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;API application Pod&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Continuously writes stdout / stderr.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="node">
          <mxGeometry x="1155" y="165" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="fluent-bit" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;FLUENT BIT POD · DaemonSet collector and filters&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=18;container=1;collapsible=0;" vertex="1" parent="node">
          <mxGeometry x="125" y="355" width="1400" height="730" as="geometry" />
        </mxCell>
        <mxCell id="fork" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;1. COPY THE ORIGINAL BEFORE MUTATING ANY FIELDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;rewrite_tag keeps raw.* untouched and emits a work.* copy. Parse application JSON only on the working copy.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="fluent-bit">
          <mxGeometry x="130" y="75" width="1140" height="110" as="geometry" />
        </mxCell>
        <mxCell id="regex" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;2. REGEX CLASSIFICATION · rewrite_tag&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Simple PII match in a supported structured format?&lt;br&gt;Unknown formats and non-matches go to Presidio.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="fluent-bit">
          <mxGeometry x="380" y="275" width="640" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fast" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;3A. LUA · FAST REDACTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Mask the matched fields.&lt;br&gt;Drop unknown fields and remaining free text.&lt;br&gt;Export approved fields under redacted.*.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="fluent-bit">
          <mxGeometry x="60" y="505" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="nlp-output" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;3B. HTTP OUTPUT · NEEDS NLP&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Send the working record to the Presidio&lt;br&gt;adapter.&lt;br&gt;A regex miss does not mean “safe”.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="fluent-bit">
          <mxGeometry x="880" y="505" width="470" height="180" as="geometry" />
        </mxCell>
        <mxCell id="adapter" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;4. PRESIDIO ADAPTER POD · Deployment&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Calls Analyzer + Anonymizer.&lt;br&gt;Emits a redacted record to normal Loki.&lt;br&gt;Failure: retry or drop; no raw fallback.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="node">
          <mxGeometry x="965" y="1145" width="550" height="180" as="geometry" />
        </mxCell>
        <mxCell id="loki" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;OPERATIONAL LOKI · REDACTED LOGS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Receives fast-path output and Presidio output.&lt;br&gt;Separate storage from the raw forensic archive.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#0891b2;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="node">
          <mxGeometry x="385" y="1425" width="660" height="120" as="geometry" />
        </mxCell>
        <mxCell id="grafana" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;NORMAL GRAFANA&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Normal users query redacted logs only.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#0891b2;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="node">
          <mxGeometry x="385" y="1610" width="660" height="110" as="geometry" />
        </mxCell>
        <mxCell id="forensic" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;FORENSIC ARCHIVE · restricted&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e87988;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=18;container=1;collapsible=0;" vertex="1" parent="node">
          <mxGeometry x="1625" y="355" width="600" height="1070" as="geometry" />
        </mxCell>
        <mxCell id="raw-loki" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;FORENSIC LOKI · RAW ORIGINALS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;All collected streams, before redaction.&lt;br&gt;Retention target: 28 days (672 hours).&lt;br&gt;Separate persistent storage.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e87988;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="forensic">
          <mxGeometry x="50" y="250" width="500" height="185" as="geometry" />
        </mxCell>
        <mxCell id="raw-grafana" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;FORENSIC GRAFANA&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Restricted investigator access.&lt;br&gt;Queries the raw archive.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff7f8;strokeColor=#e87988;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="forensic">
          <mxGeometry x="50" y="505" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="raw-policy" value="&lt;div style=&quot;font-size:22px;line-height:119%;&quot;&gt;&lt;b&gt;RETENTION AND ACCESS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:20px;line-height:122%;&quot;&gt;Loki enforces retention; Grafana only queries.&lt;br&gt;Enable the Compactor and persist its state.&lt;br&gt;Normal Grafana does not connect here.&lt;br&gt;Deletion runs asynchronously.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fda4af;strokeWidth=2;fontFamily=Arial;fontSize=22;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="forensic">
          <mxGeometry x="50" y="705" width="500" height="330" as="geometry" />
        </mxCell>
        <mxCell id="placement-note" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;All shown components run as Pods on this node. Operational and forensic Loki use separate persistent storage and separate Grafana views.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=none;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="cluster">
          <mxGeometry x="80" y="1895" width="2210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;div style=&quot;font-size:23px;line-height:119%;&quot;&gt;Teaching setup: one node provides no node redundancy. The raw archive retains original collected records for a 28-day policy window.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fbbf24;strokeWidth=2;fontFamily=Arial;fontSize=23;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
