  <diagram id="02-docker-fluentbit-routing" name="2. Fluent Bit regex routing + separate forensic archive">
    <mxGraphModel dx="2300" dy="2040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="2040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="docker" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;DOCKER HOST · two separate log stores and viewers&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=18;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="145" width="2210" height="1685" as="geometry" />
        </mxCell>
        <mxCell id="hr" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;HR service&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Continuously writes stdout / stderr.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="docker">
          <mxGeometry x="115" y="70" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="billing" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;Billing service&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Continuously writes stdout / stderr.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="docker">
          <mxGeometry x="615" y="70" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;API service&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Continuously writes stdout / stderr.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="docker">
          <mxGeometry x="1115" y="70" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="fluent-bit" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;FLUENT BIT · collector, routing and Lua filters&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=18;container=1;collapsible=0;" vertex="1" parent="docker">
          <mxGeometry x="85" y="260" width="1400" height="730" as="geometry" />
        </mxCell>
        <mxCell id="fork" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;1. COPY THE ORIGINAL BEFORE MUTATING ANY FIELDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;rewrite_tag keeps raw.* untouched and emits a work.* copy. Parse application JSON only on the working copy.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="fluent-bit">
          <mxGeometry x="130" y="75" width="1140" height="110" as="geometry" />
        </mxCell>
        <mxCell id="regex" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;2. REGEX CLASSIFICATION · rewrite_tag&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Simple PII match in a supported structured format?&lt;br&gt;Unknown formats and non-matches go to Presidio.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="fluent-bit">
          <mxGeometry x="380" y="275" width="640" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fast" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;3A. LUA · FAST REDACTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Mask the matched fields.&lt;br&gt;Drop unknown fields and remaining free text.&lt;br&gt;Export approved fields under redacted.*.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="fluent-bit">
          <mxGeometry x="60" y="505" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="nlp-output" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;3B. HTTP OUTPUT · NEEDS NLP&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Send the working record to the Presidio&lt;br&gt;adapter.&lt;br&gt;A regex miss does not mean “safe”.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="fluent-bit">
          <mxGeometry x="880" y="505" width="470" height="180" as="geometry" />
        </mxCell>
        <mxCell id="adapter" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;4. PRESIDIO ADAPTER · HTTP SERVICE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Calls Analyzer + Anonymizer.&lt;br&gt;Emits a redacted record to normal Loki.&lt;br&gt;Failure: retry or drop; no raw fallback.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="docker">
          <mxGeometry x="925" y="1050" width="550" height="180" as="geometry" />
        </mxCell>
        <mxCell id="loki" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;OPERATIONAL LOKI · REDACTED LOGS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Receives fast-path output and Presidio output.&lt;br&gt;Separate storage from the raw forensic archive.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#0891b2;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="docker">
          <mxGeometry x="345" y="1330" width="660" height="120" as="geometry" />
        </mxCell>
        <mxCell id="grafana" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;NORMAL GRAFANA&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Normal users query redacted logs only.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#0891b2;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="docker">
          <mxGeometry x="345" y="1515" width="660" height="110" as="geometry" />
        </mxCell>
        <mxCell id="forensic" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;FORENSIC ARCHIVE · restricted&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e87988;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=18;container=1;collapsible=0;" vertex="1" parent="docker">
