        </mxCell>
        <mxCell id="raw-loki" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;FORENSIC LOKI · RAW ORIGINALS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;All collected streams, before redaction.&lt;br&gt;Retention target: 28 days (672 hours).&lt;br&gt;Separate persistent storage.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e87988;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="forensic">
