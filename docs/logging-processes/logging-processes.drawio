        <mxCell id="title" value="&lt;div style=&quot;font-size:39px;line-height:119%;&quot;&gt;&lt;b&gt;1. Docker logs → script → Presidio → file&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=2;fontFamily=Arial;fontSize=39;fontColor=#142e50;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1">
