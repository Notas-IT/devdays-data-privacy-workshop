        <mxCell id="hr" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;HR service&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Continuously writes logs&lt;br&gt;stdout / stderr or a log file&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="host">
          <mxGeometry x="65" y="80" width="380" height="115" as="geometry" />
        </mxCell>
        <mxCell id="billing" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;Billing service&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Continuously writes logs&lt;br&gt;stdout / stderr or a log file&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="host">
          <mxGeometry x="565" y="80" width="380" height="115" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;API service&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Continuously writes logs&lt;br&gt;stdout / stderr or a log file&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="host">
          <mxGeometry x="1065" y="80" width="380" height="115" as="geometry" />
        </mxCell>
        <mxCell id="collector" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;2. COLLECTOR SCRIPT · COPY FIRST&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Keep the original for the forensic archive.&lt;br&gt;Send a separate working copy to Presidio.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="host">
          <mxGeometry x="400" y="295" width="710" height="135" as="geometry" />
        </mxCell>
        <mxCell id="presidio" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;3. LOCAL PRESIDIO PROCESSING&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=18;container=1;collapsible=0;" vertex="1" parent="host">
          <mxGeometry x="285" y="480" width="940" height="390" as="geometry" />
        </mxCell>
        <mxCell id="analyzer" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;Analyzer · detect possible PII&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Uses recognizers, patterns and an NLP model.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="presidio">
          <mxGeometry x="115" y="75" width="710" height="115" as="geometry" />
        </mxCell>
        <mxCell id="anonymizer" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;Anonymizer · redact detected values&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Replace detected spans with placeholders.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="presidio">
          <mxGeometry x="115" y="240" width="710" height="115" as="geometry" />
        </mxCell>
        <mxCell id="file" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;4. REDACTED OUTPUT FILE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Append processed records to redacted-logs.jsonl.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="host">
          <mxGeometry x="400" y="955" width="710" height="110" as="geometry" />
        </mxCell>
        <mxCell id="forensic" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;FORENSIC ARCHIVE · restricted&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e87988;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=18;container=1;collapsible=0;" vertex="1" parent="host">
          <mxGeometry x="1445" y="280" width="600" height="870" as="geometry" />
        </mxCell>
        <mxCell id="raw-loki" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;FORENSIC LOKI · RAW ORIGINALS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;All collected streams, before redaction.&lt;br&gt;Retention target: 28 days (672 hours).&lt;br&gt;Separate persistent storage.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e87988;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="forensic">
          <mxGeometry x="50" y="175" width="500" height="185" as="geometry" />
        </mxCell>
        <mxCell id="raw-grafana" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;FORENSIC GRAFANA&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:21px;line-height:122%;&quot;&gt;Restricted investigator access.&lt;br&gt;Queries the raw archive.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff7f8;strokeColor=#e87988;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="forensic">
          <mxGeometry x="50" y="430" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="raw-policy" value="&lt;div style=&quot;font-size:22px;line-height:119%;&quot;&gt;&lt;b&gt;RETENTION AND ACCESS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:20px;line-height:122%;&quot;&gt;Loki retention + Compactor.&lt;br&gt;Grafana only queries the archive.&lt;br&gt;Normal users have no archive access.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fda4af;strokeWidth=2;fontFamily=Arial;fontSize=22;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="forensic">
          <mxGeometry x="50" y="630" width="500" height="205" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;div style=&quot;font-size:24px;line-height:119%;&quot;&gt;&lt;b&gt;Two intentional streams: raw forensics and a redacted working output.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:10px;font-size:22px;line-height:122%;&quot;&gt;Amber = raw originals; green = redacted output. The raw archive is separate and restricted. Detectors can miss personal data.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fbbf24;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#142e50;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="95" y="1375" width="2010" height="100" as="geometry" />
        </mxCell>
        <mxCell id="collect-hr" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d97706;strokeWidth=3;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="hr" target="collector">
