        <mxCell id="raw-view" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#be4057;strokeWidth=3;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="raw-loki" target="raw-grafana">
