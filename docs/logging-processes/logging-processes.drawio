  <diagram id="01-docker-script-presidio" name="1. Docker logs → script → Presidio → file">
    <mxGraphModel dx="2200" dy="1510" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1510" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="host" value="&lt;div style=&quot;font-size:25px;line-height:119%;&quot;&gt;&lt;b&gt;LOCAL DOCKER DEMO&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#142e50;align=left;verticalAlign=top;spacing=18;container=1;collapsible=0;" vertex="1" parent="1">
