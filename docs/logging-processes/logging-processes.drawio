        <mxCell id="write" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#059669;strokeWidth=3;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="anonymizer" target="file">
          <mxGeometry relative="1" as="geometry" />
