<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" version="26.0.0">
  <diagram id="code-defined-clone" name="Code-defined database refresh">
    <mxGraphModel dx="1550" dy="1760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="1760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;A reusable production-to-preprod refresh&lt;/b&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=33;align=left;verticalAlign=middle;spacing=18;align=center;">
          <mxGeometry x="100" y="15" width="1350" height="65" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;b&gt;Read top to bottom. Side boxes are files or code used by the process.&lt;/b&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=22;align=left;verticalAlign=middle;spacing=18;align=center;">
          <mxGeometry x="100" y="80" width="1350" height="45" as="geometry" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;1. READ PRODUCTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;One read-only, consistent snapshot." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="510" y="160" width="590" height="100" as="geometry" />
        </mxCell>
        <mxCell id="current" value="&lt;b&gt;2. GENERATE CURRENT SCHEMA FILES&lt;/b&gt;&lt;br&gt;&lt;br&gt;production.current.json + .txt&lt;br&gt;Tables and columns sorted alphabetically.&lt;br&gt;Column types and nullability included." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="510" y="315" width="590" height="125" as="geometry" />
        </mxCell>
        <mxCell id="compare" value="&lt;b&gt;3. COMPARE WITH THE PREVIOUS FILE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Find added, removed or changed definitions." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="510" y="500" width="590" height="100" as="geometry" />
        </mxCell>
        <mxCell id="previous" value="&lt;b&gt;PREVIOUS SOURCE SCHEMA&lt;/b&gt;&lt;br&gt;&lt;br&gt;production.previous.json&lt;br&gt;Source schema of the last&lt;br&gt;successful refresh." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="65" y="480" width="365" height="165" as="geometry" />
        </mxCell>
        <mxCell id="difference" value="&lt;b&gt;4. WRITE THE DIFF&lt;/b&gt;&lt;br&gt;&lt;br&gt;schema.diff.json&lt;br&gt;Review what changed in production." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="510" y="660" width="590" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;5. CHECK COLUMN COVERAGE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Every source column has a rule.&lt;br&gt;Types and nullability match." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#eab308;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=19;align=left;verticalAlign=middle;spacing=18;align=center;spacing=25;">
          <mxGeometry x="625" y="845" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="definition" value="&lt;b&gt;preprod_schema.py · STUDENT CODE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Defines target tables, columns and keys.&lt;br&gt;Every column names its source and rule.&lt;br&gt;&lt;br&gt;people.email → token_email(&amp;quot;email&amp;quot;)&lt;br&gt;employment.employee_email → same scope&lt;br&gt;first_name → constant(&amp;quot;Person&amp;quot;)&lt;br&gt;payload → null() or explicit omission" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="65" y="825" width="465" height="260" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;STOP AND REVIEW&lt;/b&gt;&lt;br&gt;&lt;br&gt;No target data is changed.&lt;br&gt;Add or revise rules in&lt;br&gt;preprod_schema.py, then rerun." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#f43f5e;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="1160" y="845" width="325" height="160" as="geometry" />
        </mxCell>
        <mxCell id="code-files" value="&lt;b&gt;CODE ALSO GENERATES&lt;/b&gt;&lt;br&gt;&lt;br&gt;preprod.sql&lt;br&gt;The target DDL.&lt;br&gt;&lt;br&gt;column-mapping.txt&lt;br&gt;Each source → target + rule.&lt;br&gt;&lt;br&gt;refresh.plan.json&lt;br&gt;Coverage and blockers." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=19;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="1160" y="320" width="325" height="220" as="geometry" />
        </mxCell>
        <mxCell id="transform" value="&lt;b&gt;6. TRANSFORM BEFORE COPYING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keep, mask, null, tokenise or omit explicitly.&lt;br&gt;Shared token scopes preserve joins.&lt;br&gt;Domain violations reject the refresh." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#14b8a6;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="510" y="1120" width="590" height="120" as="geometry" />
        </mxCell>
        <mxCell id="staging" value="&lt;b&gt;7. VALIDATE RESTRICTED STAGING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Target schema comes from Python code.&lt;br&gt;Check row counts, keys, foreign keys and CHECKs." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#14b8a6;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="510" y="1300" width="590" height="115" as="geometry" />
        </mxCell>
        <mxCell id="publish" value="&lt;b&gt;8. ATOMICALLY PUBLISH PREPROD&lt;/b&gt;&lt;br&gt;&lt;br&gt;Failure rolls back and preserves the old clone." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#22c55e;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="510" y="1475" width="590" height="95" as="geometry" />
        </mxCell>
        <mxCell id="advance" value="&lt;b&gt;9. SAVE THE NEW BASELINE&lt;/b&gt;&lt;br&gt;&lt;br&gt;After publication commits, save&lt;br&gt;the current schema as previous&lt;br&gt;for the next refresh." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="65" y="1475" width="365" height="120" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;Pseudonymised + masked test data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stable identifiers can still enable linkage. Preserved joins and passing checks do not establish anonymity." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#172554;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=middle;spacing=18;align=center;">
          <mxGeometry x="100" y="1640" width="1350" height="85" as="geometry" />
        </mxCell>
